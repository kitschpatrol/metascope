				"generate-license-fingerprints": "tsx scripts/generate-license-fingerprints.ts",
				"lint": "pnpm build && ksc lint",
				"release": "bumpp --commit 'Release: %s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
				"pretest": "tsx scripts/copy-grammars.ts",
				"test": "vitest run",
				"test:live": "METASCOPE_TEST_MOCK=false vitest run",
