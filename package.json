{
	"name": "metascope",
	"version": "0.11.0",
	"description": "A CLI tool and TypeScript library to easily extract metadata from all kinds of software repositories.",
	"keywords": [
		"metadata",
		"codemeta",
		"cli",
		"git",
		"repository",
		"software-analytics",
		"metrics",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/metascope",
	"bugs": "https://github.com/kitschpatrol/metascope/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/metascope.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"metascope": "dist/bin/cli.js"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"bench": "vitest bench --run --no-file-parallelism --compare test/benchmarks/baseline.json",
		"bench:baseline": "vitest bench --run --no-file-parallelism --outputJson test/benchmarks/baseline.json",
		"build": "tsdown",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"docs": "tsx ./scripts/generate-examples.ts && ksc-prettier fix ./docs",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op read 'op://Personal/npm/otp')",
		"pretest": "tsx scripts/copy-grammars.ts",
		"test": "vitest run",
		"test:live": "METASCOPE_TEST_MOCK=false vitest run",
		"update-license-urls": "tsx ./scripts/update-license-urls.ts"
	},
	"dependencies": {
		"@kitschpatrol/tokei": "^2.0.2",
		"@mshibanami-org/xcode": "^1.1.0",
		"@sindresorhus/is": "^8.1.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "~24.13.3",
		"@types/yargs": "^17.0.35",
		"case-police": "^2.2.1",
		"defu": "^6.1.7",
		"fast-xml-parser": "^5.11.0",
		"find-workspaces": "^0.3.1",
		"git-url-parse": "^16.1.0",
		"gray-matter-es": "^0.2.1",
		"jiti": "^2.7.0",
		"lognow": "^0.8.0",
		"octokit": "^5.0.5",
		"package-json": "^10.0.1",
		"picomatch": "^4.0.7",
		"pkg-types": "^2.3.1",
		"plist": "^5.0.0",
		"pretty-ms": "^9.3.0",
		"read-pkg": "^10.1.0",
		"read-pyproject": "^0.3.3",
		"remark-parse": "^11.0.0",
		"semver": "^7.8.5",
		"simple-git": "^3.36.0",
		"smol-toml": "^1.8.0",
		"spdx-license-list": "^6.12.0",
		"string-ts": "^2.3.1",
		"tinyexec": "^1.3.0",
		"tinyglobby": "^0.2.17",
		"unified": "^11.0.5",
		"updates": "^18.0.6",
		"web-tree-sitter": "^0.26.13",
		"yaml": "^2.9.0",
		"yargs": "^18.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@fast-csv/parse": "^5.0.7",
		"@kitschpatrol/shared-config": "^8.6.0",
		"@types/jsonld": "^1.5.15",
		"@types/picomatch": "^4.0.3",
		"@types/semver": "^7.8.0",
		"bumpp": "^12.2.1",
		"jsonld": "^9.0.0",
		"mdat-plugin-cli-help": "^3.1.0",
		"msw": "^2.15.0",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tree-sitter-python": "^0.25.0",
		"tree-sitter-ruby": "^0.23.1",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.12",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=24.16.0"
	}
}
