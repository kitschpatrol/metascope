{
	"name": "metascope",
	"version": "0.6.2",
	"description": "A CLI tool and TypeScript library to easily extract metadata from all kinds of software repositories.",
	"keywords": [
		"metadata",
		"codemeta",
		"cli",
		"git",
		"repository",
		"software-analytics",
		"metrics",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/metascope",
	"bugs": "https://github.com/kitschpatrol/metascope/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/metascope.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"metascope": "dist/bin/cli.js"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"bench": "vitest bench --run --no-file-parallelism --compare test/benchmarks/baseline.json",
		"bench:baseline": "vitest bench --run --no-file-parallelism --outputJson test/benchmarks/baseline.json",
		"build": "tsdown",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"docs": "tsx ./scripts/generate-examples.ts && ksc-prettier fix ./docs",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm run build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') && pnpm publish",
		"pretest": "tsx scripts/copy-grammars.ts",
		"test": "vitest run",
		"test:live": "METASCOPE_TEST_MOCK=false vitest run"
	},
	"dependencies": {
		"@bacons/xcode": "1.0.0-alpha.33",
		"@kitschpatrol/tokei": "^2.0.1",
		"@sindresorhus/is": "^7.2.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "~22.17.2",
		"@types/plist": "^3.0.5",
		"@types/yargs": "^17.0.35",
		"case-police": "^2.2.0",
		"defu": "^6.1.6",
		"fast-xml-parser": "^5.5.10",
		"find-workspaces": "^0.3.1",
		"git-url-parse": "^16.1.0",
		"gray-matter-es": "^0.2.1",
		"jiti": "^2.6.1",
		"lognow": "^0.6.1",
		"octokit": "^5.0.5",
		"package-json": "^10.0.1",
		"picomatch": "^4.0.4",
		"pkg-types": "^2.3.0",
		"plist": "^3.1.0",
		"pretty-ms": "^9.3.0",
		"read-pkg": "^10.1.0",
		"read-pyproject": "^0.3.2",
		"remark-parse": "^11.0.0",
		"semver": "^7.7.4",
		"simple-git": "^3.35.2",
		"smol-toml": "^1.6.1",
		"spdx-license-list": "^6.11.0",
		"string-ts": "^2.3.1",
		"tinyexec": "^1.0.4",
		"tinyglobby": "^0.2.15",
		"unified": "^11.0.5",
		"updates": "^17.13.5",
		"web-tree-sitter": "^0.26.8",
		"yaml": "^2.8.3",
		"yargs": "^18.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.2",
		"@fast-csv/parse": "^5.0.5",
		"@kitschpatrol/shared-config": "^7.1.0",
		"@types/jsonld": "^1.5.15",
		"@types/picomatch": "^4.0.3",
		"@types/semver": "^7.7.1",
		"bumpp": "^11.0.1",
		"jsonld": "^9.0.0",
		"mdat-plugin-cli-help": "^2.1.1",
		"msw": "2.12.14",
		"publint": "^0.3.18",
		"tree-sitter-python": "^0.25.0",
		"tree-sitter-ruby": "^0.23.1",
		"tsdown": "^0.21.7",
		"tsx": "^4.21.0",
		"typescript": "~5.9.3",
		"vitest": "^4.1.2"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.17.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.18.0"
		}
	}
}
